# Copy to .env in the working directory for local configuration; no secrets here.
# Precedence: constructor values > process environment > .env > code defaults.
PHOENIX_ENVIRONMENT=development
PHOENIX_API_HOST=127.0.0.1
PHOENIX_API_PORT=8000
# Optional BLAZE-6 override. Portable code default: <home>/.phoenix/data.
# Loading this path does not create directories.
PHOENIX_DATA_DIR=D:/Phoenix/data
